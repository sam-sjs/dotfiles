{
    "title": "Fn to Command+Option (hold) / Fn (double tap & hold)",
    "rules": [
        {
            "description": "Fn to Command+Option (hold) / Fn (double tap & hold)",
            "manipulators": [
                {
                    "from": {
                        "apple_vendor_top_case_key_code": "keyboard_fn",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "parameters": {
                        "basic.to_delayed_action_delay_milliseconds": 0
                    },
                    "to": [
                        {
                            "key_code": "left_command"
                        },
                        {
                            "key_code": "left_option"
                        }
                    ],
                    "to_if_alone": [
                        {
                            "apple_vendor_top_case_key_code": "keyboard_fn"
                        }
                    ],
                    "to_if_held_down": [
                        {
                            "apple_vendor_top_case_key_code": "keyboard_fn"
                        }
                    ],
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_built_in_keyboard": true
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}

