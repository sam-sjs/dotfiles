{
    "title": "Apostrophe to Control (hold) / Apostrophe (press)",
    "rules": [
        {
            "description": "Apostrophe to Control (hold) / Apostrophe (press)",
            "manipulators": [
                {
                    "from": {
                        "key_code": "quote",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "right_control"
                        }
                    ],
                    "to_if_alone": [
                        {
                            "key_code": "quote"
                        }
                    ],
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "device_if",
                            "identifiers": [
                                {
                                    "is_built_in_keyboard": true
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}

